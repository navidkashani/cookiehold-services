{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "hcaptcha",
  "version": 3,
  "name": "hCaptcha",
  "provider": "Intuition Machines, Inc.",
  "category": "functional",
  "purpose": "Keeps spam out of forms.",
  "privacyUrl": "https://www.hcaptcha.com/privacy",
  "dataCountry": "USA and other countries",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "hcaptcha.com"
    ]
  },
  "cookies": [
    {
      "name": "hmt_id",
      "lifetime": "30 days",
      "purpose": "Service statistics and accessibility support."
    },
    {
      "name": "hc_accessibility",
      "lifetime": "Up to 30 days",
      "purpose": "Enables hCaptcha's accessibility mode."
    }
  ],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": "form",
  "wordpress": {
    "plugins": [
      "hcaptcha-for-forms-and-more/hcaptcha.php"
    ],
    "handles": []
  },
  "sources": [
    "https://www.hcaptcha.com/privacy",
    "https://wordpress.org/plugins/hcaptcha-for-forms-and-more/",
    "https://www.dataprivacyframework.gov/list"
  ],
  "checked": "2026-11-06"
}
