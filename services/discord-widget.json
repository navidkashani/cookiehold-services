{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "discord-widget",
  "version": 2,
  "name": "Discord",
  "provider": "Discord Netherlands BV",
  "category": "media",
  "purpose": "Shows a Discord server's online members.",
  "privacyUrl": "https://discord.com/privacy",
  "dataCountry": "USA and other countries",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "discord.com/widget",
      "discordapp.com/widget",
      "discord.com/api/guilds"
    ]
  },
  "cookies": [],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": "social",
  "wordpress": {
    "plugins": [],
    "handles": []
  },
  "sources": [
    "https://discord.com/privacy",
    "https://discord.com/terms/cookie-policy",
    "https://discord.com/blog/add-the-discord-widget-to-your-site",
    "https://docs.discord.com/developers/resources/guild",
    "https://www.dataprivacyframework.gov/list"
  ],
  "checked": "2026-11-06"
}
