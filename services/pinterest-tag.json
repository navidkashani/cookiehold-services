{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "pinterest-tag",
  "version": 3,
  "name": "Pinterest Tag",
  "provider": "Pinterest Europe Limited and Pinterest, Inc.",
  "category": "marketing",
  "purpose": "Measures Pinterest ads.",
  "privacyUrl": "https://policy.pinterest.com/en/privacy-policy",
  "dataCountry": "USA and other countries",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "s.pinimg.com/ct",
      "ct.pinterest.com"
    ],
    "inline": [
      "pintrk('load'",
      "pintrk(\"load\"",
      "s.pinimg.com/ct/core.js"
    ]
  },
  "cookies": [
    {
      "name": "_pin_unauth",
      "lifetime": "1 year",
      "purpose": "Tells visitors apart."
    },
    {
      "name": "_epik",
      "lifetime": "1 year",
      "purpose": "Stores the ad click."
    },
    {
      "name": "_derived_epik",
      "lifetime": "1 year",
      "purpose": "Ad measurement."
    },
    {
      "name": "_pin_aem",
      "lifetime": "1 year",
      "purpose": "Stores hashed details for ad matching."
    }
  ],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [
      "pinterest-for-woocommerce/pinterest-for-woocommerce.php"
    ],
    "handles": []
  },
  "sources": [
    "https://policy.pinterest.com/en/privacy-policy",
    "https://help.pinterest.com/en/business/article/pinterest-tag-parameters-and-cookies",
    "https://help.pinterest.com/en/business/article/install-the-base-code",
    "https://www.dataprivacyframework.gov/list",
    "https://plugins.svn.wordpress.org/pinterest-for-woocommerce/trunk/pinterest-for-woocommerce.php"
  ],
  "checked": "2026-11-06"
}
