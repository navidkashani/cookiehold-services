{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "mouseflow",
  "version": 3,
  "name": "Mouseflow",
  "provider": "Mouseflow ApS",
  "category": "statistics",
  "purpose": "Heatmaps and session recordings.",
  "privacyUrl": "https://mouseflow.com/legal/privacy-policy/",
  "dataCountry": "EU or USA (account region)",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "mouseflow.com"
    ],
    "inline": [
      "window._mfq"
    ]
  },
  "cookies": [
    {
      "name": "mf_user",
      "lifetime": "90 days",
      "purpose": "Tells new from returning visitors."
    },
    {
      "name": "mf_*",
      "lifetime": "Session",
      "purpose": "Identifies the current session."
    }
  ],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [
      "mouseflow-for-wordpress/mouseflow-for-wordpress.php"
    ],
    "handles": []
  },
  "sources": [
    "https://mouseflow.com/legal/privacy-policy/",
    "https://help.mouseflow.com/en/articles/4282966-what-is-your-cookie-policy",
    "https://mouseflow.com/legal/cookie-policy/",
    "https://wordpress.org/plugins/mouseflow-for-wordpress/",
    "https://mouseflow.com/legal/privacy/",
    "https://mouseflow.com/legal/subprocessors/",
    "https://plugins.svn.wordpress.org/mouseflow-for-wordpress/trunk/mouseflow-for-wordpress.php"
  ],
  "checked": "2026-11-06"
}
