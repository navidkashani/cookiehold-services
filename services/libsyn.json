    "https://libsyn.com/tos-policies/privacy-policy/",
    "https://libsyn.com/tos-policies/data-processing-addendum/",
    "https://libsyn.com/tos-policies/gdpr-faq/",
    "https://libsyn.com/blog/libsyns-new-html5-player-is-here/",
