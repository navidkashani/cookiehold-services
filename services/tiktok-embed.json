{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "tiktok-embed",
  "version": 4,
  "name": "TikTok embeds",
  "provider": "TikTok Technology Limited and TikTok Information Technologies UK Limited",
  "category": "media",
  "purpose": "Shows embedded videos.",
  "privacyUrl": "https://www.tiktok.com/legal/page/eea/privacy-policy/en",
  "dataCountry": "USA, Malaysia and Singapore; other countries through remote access",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "tiktok.com/embed",
      "tiktok.com/embed.js",
      "tiktok.com/player"
    ]
  },
  "cookies": [
    {
      "name": "ttwid",
      "lifetime": "1 year",
      "purpose": "Security and statistics for embedded videos."
    }
  ],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": "video",
  "wordpress": {
    "plugins": [
      "feeds-for-tiktok/feeds-for-tiktok.php"
    ],
    "handles": []
  },
  "sources": [
    "https://www.tiktok.com/legal/page/eea/privacy-policy/en",
    "https://www.tiktok.com/legal/page/global/cookie-policy/en",
    "https://developers.tiktok.com/doc/embed-videos",
    "https://plugins.svn.wordpress.org/feeds-for-tiktok/trunk/feeds-for-tiktok.php",
    "https://www.tiktok.com/legal/page/global/tiktok-website-cookies-policy/en",
    "https://developers.tiktok.com/docs/en/embed-videos",
    "https://developers.tiktok.com/docs/en/embed-player"
  ],
  "checked": "2026-11-06"
}
