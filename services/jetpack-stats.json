{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "jetpack-stats",
  "version": 3,
  "name": "Jetpack Stats",
  "provider": "Aut O'Mattic A8C Ireland Ltd.",
  "category": "statistics",
  "purpose": "Counts visits.",
  "privacyUrl": "https://automattic.com/privacy-notice/",
  "dataCountry": "USA (EU-US Data Privacy Framework)",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "stats.wp.com",
