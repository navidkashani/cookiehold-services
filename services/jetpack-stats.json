    "plugins": [
      "jetpack/jetpack.php"
    ],
    "handles": []
  },
  "sources": [
    "https://automattic.com/privacy/",
    "https://jetpack.com/support/cookies/",
    "https://jetpack.com/support/jetpack-stats/",
    "https://wordpress.org/plugins/jetpack/",
    "https://www.dataprivacyframework.gov/list",
    "https://automattic.com/privacy-notice/",
    "https://plugins.svn.wordpress.org/jetpack/trunk/jetpack.php",
    "https://plugins.svn.wordpress.org/jetpack/trunk/jetpack_vendor/automattic/jetpack-stats/src/class-tracking-pixel.php"
  ],
  "checked": "2026-11-06"
}
