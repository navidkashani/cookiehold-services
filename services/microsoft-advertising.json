{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "microsoft-advertising",
  "version": 3,
  "name": "Microsoft Advertising (UET)",
  "provider": "Microsoft Ireland Operations Limited",
  "category": "marketing",
  "purpose": "Measures Microsoft Advertising (Bing) ads.",
  "privacyUrl": "https://www.microsoft.com/en-us/privacy/privacystatement",
  "dataCountry": "USA and other countries",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "bat.bing.com"
    ],
    "inline": [
      "bat.bing.com/bat.js"
    ]
  },
  "cookies": [
    {
      "name": "_uetsid",
      "lifetime": "1 day",
      "purpose": "Ad measurement."
    },
    {
      "name": "_uetvid",
      "lifetime": "390 days",
      "purpose": "Ad measurement."
    },
    {
      "name": "MUID",
      "lifetime": "1 year",
      "purpose": "Tells browsers apart."
    },
    {
      "name": "_uetmsclkid",
      "lifetime": "90 days",
      "purpose": "Stores the Microsoft ad click."
    }
  ],
  "storage": [
    "_uetsid",
    "_uetsid_exp",
    "_uetvid",
    "_uetvid_exp",
    "_uetmsclkid",
    "_uetmsclkid_exp"
  ],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [],
    "handles": []
  },
  "sources": [
    "https://learn.microsoft.com/en-us/advertising/msa-help/hlp_ba_conc_uet_consent",
    "https://learn.microsoft.com/en-us/advertising/msa-help/hlp_ba_conc_uet_consentfaq",
    "https://www.microsoft.com/en-us/privacy/privacystatement",
    "https://github.com/jkwakman/Open-Cookie-Database",
    "https://www.dataprivacyframework.gov/list",
    "https://bat.bing.com/bat.js",
    "https://learn.microsoft.com/en-us/advertising/msa-help/hlp_ba_conc_uet_parameters_table"
  ],
  "checked": "2026-11-06"
}
