{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "kustom",
  "version": 2,
  "name": "Kustom Checkout",
  "provider": "Kustom AB",
  "category": "essential",
  "purpose": "Runs the checkout and processes payments.",
  "privacyUrl": "https://cdn.kustom.co/terms/02/kustom-checkout-privacy-notice.pdf",
  "dataCountry": "EEA, USA and UK",
  "legalBasis": "contract",
  "match": {
    "hosts": [
      "js.live.kustom.co",
      "js.playground.kustom.co",
      "kustomcdn.co"
    ],
    "inline": [
      "'_klarnaCheckout','klarna-checkout-container'",
      "kustom.co/kco/checkout/orders/",
      "window.kustomElements._internal"
    ]
  },
  "cookies": [
    {
      "name": "kdid",
      "lifetime": "730 days from last purchase",
      "purpose": "Remembers autofill details and preferences."
    }
  ],
  "storage": [
    "_kustom_*",
    "_klarna_sdid_ch"
  ],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [
      "klarna-checkout-for-woocommerce/klarna-checkout-for-woocommerce.php"
    ],
    "handles": []
  },
  "sources": [
    "https://docs.kustom.co/checkout/integrate/render-checkout-snippet.md",
    "https://docs.kustom.co/checkout/client-side-events.md",
    "https://docs.kustom.co/checkout/surfaces/elements.md",
    "https://docs.kustom.co/llms.txt",
    "https://cdn.kustom.co/terms/02/kustom-checkout-privacy-notice.pdf",
    "https://www.kustom.co/legal",
    "https://www.kustom.co/legal/privacy-policy",
    "https://demo.kustom.co/",
    "https://js.playground.kustom.co/kcoc/261029-861145d/checkout.bootstrap.js",
    "https://js.live.kustom.co/kustom-elements/v1/pre-load.js",
    "https://wordpress.org/plugins/klarna-checkout-for-woocommerce/",
    "https://plugins.svn.wordpress.org/klarna-checkout-for-woocommerce/trunk/"
  ],
  "checked": "2026-11-06"
}
