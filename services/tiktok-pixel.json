{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "tiktok-pixel",
  "version": 3,
  "name": "TikTok Pixel",
  "provider": "TikTok Technology Limited and TikTok Information Technologies UK Limited",
  "category": "marketing",
  "purpose": "Measures TikTok ads.",
  "privacyUrl": "https://www.tiktok.com/legal/page/eea/privacy-policy/en",
  "dataCountry": "USA, Malaysia and Singapore; remote access from other countries",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "analytics.tiktok.com"
    ],
    "inline": [
      "analytics.tiktok.com/i18n/pixel"
    ]
  },
  "cookies": [
    {
      "name": "_ttp",
      "lifetime": "13 months",
      "purpose": "Ad measurement."
    },
    {
      "name": "ttcsid*",
      "lifetime": "13 months",
      "purpose": "Ad measurement."
    },
    {
      "name": "ttclid",
      "lifetime": "13 months",
      "purpose": "Ad measurement."
    }
  ],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [],
    "handles": []
  },
  "sources": [
    "https://www.tiktok.com/legal/page/eea/privacy-policy/en",
    "https://ads.tiktok.com/help/article/using-cookies-with-tiktok-pixel",
    "https://www.tiktok.com/legal/page/global/cookie-policy/en"
  ],
  "checked": "2026-11-06"
}
