{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "google-tag-manager",
  "version": 3,
  "name": "Google Tag Manager",
  "provider": "Google Ireland Limited",
  "category": "essential",
  "purpose": "Loads the site's other tags.",
  "privacyUrl": "https://policies.google.com/privacy",
  "dataCountry": "Worldwide",
  "legalBasis": "legitimate-interest",
  "match": {
    "hosts": [
      "googletagmanager.com/gtm.js",
      "googletagmanager.com/ns.html"
    ],
    "inline": [
      "googletagmanager.com/gtm.js"
    ]
  },
  "cookies": [],
  "storage": [],
  "consentMode": {
    "google": true,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [
      "google-site-kit/google-site-kit.php",
      "duracelltomi-google-tag-manager/duracelltomi-google-tag-manager-for-wordpress.php"
    ],
    "handles": []
  },
  "sources": [
    "https://policies.google.com/privacy",
    "https://policies.google.com/privacy/frameworks",
    "https://developers.google.com/tag-platform/security/guides/privacy",
    "https://www.dataprivacyframework.gov/list",
    "https://plugins.svn.wordpress.org/duracelltomi-google-tag-manager/trunk/duracelltomi-google-tag-manager-for-wordpress.php",
    "https://support.google.com/tagmanager/answer/10718549?hl=en",
    "https://support.google.com/tagmanager/answer/9323295?hl=en",
    "https://support.google.com/tagmanager/answer/14847097?hl=en",
    "https://developers.google.com/tag-platform/security/concepts/consent-mode",
    "https://plugins.svn.wordpress.org/google-site-kit/trunk/google-site-kit.php"
  ],
  "checked": "2026-11-06"
}
