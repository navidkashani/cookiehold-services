{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "mixpanel",
  "version": 2,
  "name": "Mixpanel",
  "provider": "Mixpanel, Inc.",
  "category": "statistics",
  "purpose": "Measures how visitors use the site.",
  "privacyUrl": "https://mixpanel.com/legal/privacy-policy/",
  "dataCountry": "USA, EU or India (selected region); other countries for support and AI",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "mixpanel.com",
      "mxpnl.com"
    ],
    "inline": [
      "mixpanel.init(",
      "cdn.mxpnl.com/libs/mixpanel"
    ]
  },
  "cookies": [
    {
      "name": "mp_*",
      "lifetime": "1 year",
      "purpose": "Tells visitors apart."
    }
  ],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [],
    "handles": []
  },
  "sources": [
    "https://mixpanel.com/legal/privacy-policy/",
    "https://docs.mixpanel.com/docs/tracking-methods/sdks/javascript",
    "https://dataprivacyframework.gov/list",
    "https://github.com/jkwakman/Open-Cookie-Database",
    "https://www.dataprivacyframework.gov/list",
    "https://mixpanel.com/legal/eu-data-residency/",
    "https://mixpanel.com/legal/subprocessor-list/",
    "https://raw.githubusercontent.com/mixpanel/mixpanel-js/master/src/mixpanel-persistence.js"
  ],
  "checked": "2026-11-06"
}
