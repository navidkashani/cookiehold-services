{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "wix-media",
  "version": 2,
  "name": "Wix Media",
  "provider": "Wix.com Ltd.",
  "category": "media",
  "purpose": "Shows images and videos hosted by Wix.",
  "privacyUrl": "https://www.wix.com/about/privacy",
  "dataCountry": "USA, EU (Ireland) and other countries",
