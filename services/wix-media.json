    "https://support.wix.com/en/article/wix-media-request-editing-the-url-of-a-media-file",
    "https://dev.wix.com/docs/api-reference/assets/media/media-manager/url-image-transformation",
    "https://www.wix.com/about/cookie-policy",
    "https://www.wix.com/about/privacy",
    "https://www.dataprivacyframework.gov/list",
    "https://www.wpbeginner.com/wp-tutorials/how-to-properly-switch-from-wix-to-wordpress-step-by-step/",
    "https://www.wix.com/trust-center/faq",
    "https://support.wix.com/en/article/preparing-your-wix-site-for-the-gdpr"
