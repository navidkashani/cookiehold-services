{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "openstreetmap",
  "version": 4,
  "name": "OpenStreetMap",
  "provider": "OpenStreetMap Foundation",
  "category": "media",
  "purpose": "Shows embedded maps.",
  "privacyUrl": "https://osmfoundation.org/wiki/Privacy_Policy",
  "dataCountry": "UK and EU (Netherlands); global tile cache network",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "openstreetmap.org/export/embed.html",
      "tile.openstreetmap.org"
    ]
  },
  "cookies": [],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": "map",
  "wordpress": {
    "plugins": [
      "leaflet-map/leaflet-map.php",
      "leaflet-maps-marker/leaflet-maps-marker.php",
      "wp-store-locator/wp-store-locator.php",
      "acf-openstreetmap-field/index.php"
    ],
    "handles": []
  },
  "sources": [
    "https://osmfoundation.org/wiki/Privacy_Policy",
    "https://plugins.svn.wordpress.org/leaflet-map/trunk/",
    "https://plugins.svn.wordpress.org/leaflet-maps-marker/trunk/",
    "https://plugins.svn.wordpress.org/wp-store-locator/trunk/",
    "https://plugins.svn.wordpress.org/acf-openstreetmap-field/trunk/",
    "https://plugins.svn.wordpress.org/wp-google-maps/trunk/",
    "https://operations.osmfoundation.org/policies/tiles/"
  ],
  "checked": "2026-11-06"
}
