{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "google-ads",
  "version": 6,
  "name": "Google Ads",
  "provider": "Google Ireland Limited",
  "category": "marketing",
  "purpose": "Measures ads and shows them to past visitors.",
  "privacyUrl": "https://policies.google.com/privacy",
  "dataCountry": "Worldwide",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "googletagmanager.com/gtag/js?id=AW-",
      "googleadservices.com",
      "googleads.g.doubleclick.net",
      "doubleclick.net",
      "google.com/pagead"
    ],
    "inline": [
      "gtag('config', 'AW-",
      "gtag(\"config\", \"AW-",
      "gtag('config','AW-",
      "gtag(\"config\",\"AW-"
    ]
  },
  "cookies": [
    {
      "name": "_gcl_au",
      "lifetime": "90 days",
      "purpose": "Links ad clicks to conversions."
    },
    {
      "name": "_gcl_aw",
      "lifetime": "90 days",
      "purpose": "Stores the ad click."
    },
    {
      "name": "IDE",
      "lifetime": "13–24 months (by region)",
      "purpose": "Ad delivery and measurement.",
      "httpOnly": true
    }
  ],
  "storage": [],
  "consentMode": {
    "google": true,
    "advanced": true
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [
      "google-site-kit/google-site-kit.php",
      "google-listings-and-ads/google-listings-and-ads.php",
      "kliken-marketing-for-google/kliken-marketing-for-google.php"
    ],
    "handles": [
      "gla-gtag-events",
      "google_gtagjs-AW-*"
    ]
  },
  "sources": [
    "https://business.safety.google/adscookies/",
    "https://policies.google.com/technologies/cookies",
    "https://policies.google.com/privacy/frameworks",
    "https://policies.google.com/privacy",
    "https://www.dataprivacyframework.gov/list",
    "https://plugins.svn.wordpress.org/google-listings-and-ads/trunk/google-listings-and-ads.php",
    "https://plugins.svn.wordpress.org/kliken-marketing-for-google/trunk/kliken-marketing-for-google.php",
    "https://plugins.svn.wordpress.org/google-site-kit/tags/1.190.0/includes/Core/Tags/GTag.php"
  ],
  "checked": "2026-11-07"
}
