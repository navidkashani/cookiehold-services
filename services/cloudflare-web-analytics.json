{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "cloudflare-web-analytics",
  "version": 2,
  "name": "Cloudflare Web Analytics",
  "provider": "Cloudflare, Inc.",
  "category": "statistics",
  "purpose": "Measures visits without cookies.",
  "privacyUrl": "https://www.cloudflare.com/privacypolicy/",
  "dataCountry": "USA, EEA and other countries",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "cloudflareinsights.com"
    ]
  },
  "cookies": [],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [],
    "handles": []
  },
  "sources": [
    "https://www.cloudflare.com/privacypolicy/",
    "https://developers.cloudflare.com/speed/observatory/rum-beacon/",
    "https://developers.cloudflare.com/web-analytics/data-metrics/data-origin-and-collection/",
    "https://www.dataprivacyframework.gov/list",
    "https://www.cloudflare.com/web-analytics/"
  ],
  "checked": "2026-11-06"
}
